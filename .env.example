PORT=4000
CLIENT_ORIGIN=http://localhost:5173
# REQUIRED: strong random secret, min 32 chars. Server refuses to start without it.
JWT_SECRET=change-this-in-production-to-a-random-32-plus-char-string

# Error tracking (Sentry). Optional — leave unset to disable.
# SENTRY_DSN=https://xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx@o000000.ingest.sentry.io/0000000
# SENTRY_TRACES_SAMPLE_RATE=0.1

# Resend (email verification codes)
# Get a free API key at https://resend.com
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# RESEND_FROM=onboarding@resend.dev

# AI Provider: NVIDIA (recommended), OpenRouter, or Google Gemini
# NVIDIA is tried first, then OpenRouter, then Gemini, then local fallback
# Get a free NVIDIA API key at https://build.nvidia.com
# NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# NVIDIA_MODEL=meta/llama-3.1-70b-instruct

# OPENROUTER_API_KEY=your-key-here
# OPENROUTER_MODEL=openai/gpt-4o-mini
# GEMINI_API_KEY=your-key-here
