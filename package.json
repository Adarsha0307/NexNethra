{
  "name": "nexnetra",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace frontend",
    "dev:backend": "npm run dev --workspace backend",
    "dev:all": "node dev.cjs",
    "setup-ssl": "node scripts/setup-ssl.mjs",
    "migrate": "node backend/src/utils/migrate.js",
    "build": "npm run build --workspace frontend && rm -rf dist && cp -r frontend/dist dist",
    "start": "npm run start --workspace backend",
    "test": "npm run test --workspace backend && npm run test --workspace frontend"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "motion": "^12.43.0",
    "tailwind-merge": "^3.6.0"
  }
}